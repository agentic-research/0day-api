{
  "name": "0day-api",
  "version": "0.0.0",
  "private": true,
  "description": "Derive a dependency map from what repositories already declare, and serve it as data.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "tsc -b packages/core packages/collect packages/mcp",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-research/0day-api.git"
  }
}
