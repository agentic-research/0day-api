{
  "name": "0day-api",
  "version": "0.0.0",
  "private": true,
  "description": "Derive a dependency map from what repositories already declare, and serve it as data.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:readmes": "node --test scripts/readmes.test.mjs",
    "test:packages": "node --test scripts/package-contents.test.mjs",
    "readmes": "node scripts/readmes.mjs",
    "readmes:check": "node scripts/readmes.mjs --check",
    "packages:check": "pnpm run test:packages && node scripts/package-contents.mjs",
    "typecheck": "tsc -b packages/core packages/collect packages/mcp",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.6.2",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-research/0day-api.git"
  }
}
