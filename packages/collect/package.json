{
  "name": "@agentic-research/depgraph-collect",
  "version": "0.1.0",
  "description": "Read what repositories declare \u2014 manifests, lockfiles, workflows \u2014 into a sources lock the portable core derives from. Node-only, no credential.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "pnpm run test:package",
    "test:package": "pnpm run build && node -e \"import('./dist/index.js').then(() => console.log('package import ok'))\""
  },
  "dependencies": {
    "@agentic-research/depgraph-core": "workspace:*",
    "smol-toml": "^1.7.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-research/0day-api.git",
    "directory": "packages/collect"
  },
  "keywords": [
    "dependency-graph",
    "manifest",
    "monorepo",
    "provenance"
  ]
}
