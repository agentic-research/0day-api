{
  "name": "@agentic-research/depgraph-core",
  "version": "0.1.0",
  "description": "Portable dependency-map contract, derivation and gate. One dependency (zod), no filesystem, no network \u2014 runs in workerd.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "pnpm run test:workerd",
    "test:workerd": "vitest run --config vitest.workerd.config.mts",
    "test:package": "pnpm run build && node -e \"import('./dist/index.js').then(() => console.log('package import ok'))\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-research/0day-api.git",
    "directory": "packages/core"
  },
  "keywords": [
    "dependency-graph",
    "provenance",
    "sbom",
    "monorepo",
    "zod"
  ]
}
