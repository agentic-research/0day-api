{
  "name": "@agentic-research/depgraph-core",
  "version": "0.1.0",
  "description": "Portable dependency-map contract and derivation: authored/derived boundary, resolution confidence, and a re-derivable artifact — no filesystem or network.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["README.md", "dist/**/*.js", "dist/**/*.d.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "smol-toml": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-research/0day-api.git",
    "directory": "packages/core"
  },
  "keywords": ["dependency-graph", "provenance", "sbom", "monorepo", "zod"]
}
