{
  "compilerOptions": {
    "target": "ES2022",
    // DOM for URL/URLSearchParams only. This package must run in workerd and
    // the browser as well as Node, so it takes globals from the platform
    // rather than from @types/node.
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
